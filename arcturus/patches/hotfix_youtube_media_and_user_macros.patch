+package com.eu.habbo.messages.incoming.rooms.users;
+
+import com.eu.habbo.habbohotel.rooms.Room;
+import com.eu.habbo.habbohotel.users.Habbo;
+import com.eu.habbo.messages.incoming.MessageHandler;
+
+import java.util.Set;
+
+/**
+ * Lets any player throw one of a small curated set of cosmetic effects onto another
+ * player standing in the same room -- a "silly macro" button, not a moderation tool, so
+ * there's no rank gate. The effect ID is restricted to a fixed whitelist (matching the
+ * icons offered client-side) so a modified client can't force an arbitrary/inappropriate
+ * effect onto someone; the duration is fixed server-side for the same reason.
+ */
+public class ThrowEffectAtUserEvent extends MessageHandler {
+    private static final Set<Integer> ALLOWED_EFFECT_IDS = Set.of(9, 7, 4, 13); // Love, Butterflies, Twinkle, Ghost
+    private static final int EFFECT_DURATION_SECONDS = 8;
+
+    @Override
+    public void handle() {
+        int userId = this.packet.readInt();
+        int effectId = this.packet.readInt();
+
+        if (!ALLOWED_EFFECT_IDS.contains(effectId)) return;
+
+        Room room = this.client.getHabbo().getHabboInfo().getCurrentRoom();
+
+        if (room == null) return;
+
+        Habbo target = room.getHabbo(userId);
+
+        if (target == null || target == this.client.getHabbo()) return;
+
+        room.giveEffect(target, effectId, EFFECT_DURATION_SECONDS);
+    }
+}
