+package com.eu.habbo.messages.incoming.rooms.users;
+
+import com.eu.habbo.Emulator;
+import com.eu.habbo.habbohotel.rooms.Room;
+import com.eu.habbo.habbohotel.users.Habbo;
+import com.eu.habbo.messages.incoming.MessageHandler;
+import com.eu.habbo.threading.runnables.RoomUnitWalkToRoomUnit;
+
+/**
+ * Lets any player make another player standing in the same room walk over to them --
+ * a friendly "silly macro" gesture, not a teleport. Reuses the same
+ * RoomUnitWalkToRoomUnit pathfinding already used for e.g. passing a hand-carried item
+ * (PassCarryItemEvent), just with the walker/target roles swapped: there, the sender
+ * walks to the recipient; here, the target walks to the sender.
+ */
+public class PullUserEvent extends MessageHandler {
+    @Override
+    public void handle() {
+        int userId = this.packet.readInt();
+
+        Room room = this.client.getHabbo().getHabboInfo().getCurrentRoom();
+
+        if (room == null) return;
+
+        Habbo target = room.getHabbo(userId);
+
+        if (target == null || target == this.client.getHabbo()) return;
+
+        Emulator.getThreading().run(new RoomUnitWalkToRoomUnit(target.getRoomUnit(), this.client.getHabbo().getRoomUnit(), room, null, null));
+    }
+}
