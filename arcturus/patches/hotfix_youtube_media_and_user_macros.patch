@@ -0,0 +1,77 @@
+package com.eu.habbo.messages.incoming.rooms.items.youtube;
+
+import com.eu.habbo.Emulator;
+import com.eu.habbo.habbohotel.items.YoutubeManager;
+import com.eu.habbo.habbohotel.items.interactions.InteractionYoutubeTV;
+import com.eu.habbo.habbohotel.rooms.Room;
+import com.eu.habbo.habbohotel.users.Habbo;
+import com.eu.habbo.habbohotel.users.HabboItem;
+import com.eu.habbo.messages.outgoing.handshake.ErrorReportComposer;
+import com.eu.habbo.messages.outgoing.rooms.items.youtube.YoutubeDisplayVideoMessageComposer;
+
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/**
+ * Lets a rank 7 (Admin-only) user push an arbitrary YouTube video onto a Video TV,
+ * bypassing the normal admin-curated youtube_playlists system entirely. Reuses the
+ * existing YoutubeDisplayVideoMessageComposer/InteractionYoutubeTV plumbing -- the only
+ * new wire format is this incoming packet itself. No auto-advance is scheduled since
+ * there's no playlist context to advance through; the duration sent to the client is a
+ * generous upper bound (the real YouTube player still stops at the video's actual end,
+ * this only controls the optional server-side "end" timestamp).
+ */
+public class SetYoutubeCustomVideoEvent extends YoutubeEvent {
+    private static final int REQUIRED_RANK = 7;
+    private static final int FALLBACK_DURATION_SECONDS = 36000;
+
+    private static final Pattern VIDEO_ID_PATTERN = Pattern.compile(
+            "(?:youtube\\.com/(?:watch\\?v=|embed/|shorts/)|youtu\\.be/)([A-Za-z0-9_-]{11})|^([A-Za-z0-9_-]{11})$"
+    );
+
+    @Override
+    public void handle() {
+        int itemId = this.packet.readInt();
+        String rawInput = this.packet.readString();
+
+        Habbo habbo = this.client.getHabbo();
+
+        if (!validate(habbo)) return;
+
+        if (habbo.getHabboInfo().getPermissionGroup().getId() < REQUIRED_RANK) {
+            this.client.sendResponse(new ErrorReportComposer(1000));
+            return;
+        }
+
+        Room room = habbo.getHabboInfo().getCurrentRoom();
+        HabboItem item = room.getHabboItem(itemId);
+
+        if (!(item instanceof InteractionYoutubeTV tv)) return;
+
+        String videoId = extractVideoId(rawInput.trim());
+
+        if (videoId == null) {
+            this.client.sendResponse(new ErrorReportComposer(1000));
+            return;
+        }
+
+        tv.cancelAdvancement();
+        tv.currentPlaylist = null;
+        tv.currentVideo = new YoutubeManager.YoutubeVideo(videoId, FALLBACK_DURATION_SECONDS);
+        tv.startedWatchingAt = Emulator.getIntUnixTimestamp();
+        tv.offset = 0;
+        tv.playing = true;
+
+        room.updateItem(tv);
+        room.sendComposer(new YoutubeDisplayVideoMessageComposer(itemId, tv.currentVideo, true, 0).compose());
+        item.needsUpdate(true);
+    }
+
+    private String extractVideoId(String input) {
+        Matcher matcher = VIDEO_ID_PATTERN.matcher(input);
+
+        if (!matcher.find()) return null;
+
+        return matcher.group(1) != null ? matcher.group(1) : matcher.group(2);
+    }
+}
