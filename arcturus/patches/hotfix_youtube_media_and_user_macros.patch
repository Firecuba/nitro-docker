+package com.eu.habbo.messages.incoming.rooms.items.youtube;
+
+import com.eu.habbo.Emulator;
+import com.eu.habbo.habbohotel.items.interactions.InteractionYoutubeTV;
+import com.eu.habbo.habbohotel.rooms.Room;
+import com.eu.habbo.habbohotel.users.Habbo;
+import com.eu.habbo.habbohotel.users.HabboItem;
+import com.eu.habbo.messages.outgoing.handshake.ErrorReportComposer;
+
+/**
+ * Lets a rank 7 (Admin-only) user point a Video TV at a video file the admin uploaded
+ * themselves (via the Housekeeping-adjacent upload endpoint), instead of a YouTube
+ * video. The URL is restricted to the configured upload base so this can't be used to
+ * point the screen at an arbitrary external URL -- only at something that actually went
+ * through the upload flow (and, on the client, its own-content acknowledgment checkbox).
+ */
+public class SetCustomUploadedVideoEvent extends YoutubeEvent {
+    private static final int REQUIRED_RANK = 7;
+
+    @Override
+    public void handle() {
+        int itemId = this.packet.readInt();
+        String url = this.packet.readString().trim();
+
+        Habbo habbo = this.client.getHabbo();
+
+        if (!validate(habbo)) return;
+
+        if (habbo.getHabboInfo().getPermissionGroup().getId() < REQUIRED_RANK) {
+            this.client.sendResponse(new ErrorReportComposer(1000));
+            return;
+        }
+
+        String allowedBase = Emulator.getConfig().getValue("customvideo.upload.baseurl", "");
+
+        if (allowedBase.isEmpty() || !url.startsWith(allowedBase)) {
+            this.client.sendResponse(new ErrorReportComposer(1000));
+            return;
+        }
+
+        Room room = habbo.getHabboInfo().getCurrentRoom();
+        HabboItem item = room.getHabboItem(itemId);
+
+        if (!(item instanceof InteractionYoutubeTV tv)) return;
+
+        tv.cancelAdvancement();
+        tv.currentPlaylist = null;
+        tv.currentVideo = null;
+        tv.customVideoUrl = url;
+        tv.startedWatchingAt = Emulator.getIntUnixTimestamp();
+        tv.offset = 0;
+        tv.playing = true;
+
+        room.updateItem(tv);
+        room.sendComposer(new com.eu.habbo.messages.outgoing.rooms.items.youtube.CustomVideoDisplayMessageComposer(itemId, url).compose());
+        item.needsUpdate(true);
+    }
+}
