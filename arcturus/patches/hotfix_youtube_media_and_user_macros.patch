+package com.eu.habbo.messages.incoming.rooms.items.youtube;
+
+import com.eu.habbo.Emulator;
+import com.eu.habbo.habbohotel.items.interactions.InteractionYoutubeTV;
+import com.eu.habbo.habbohotel.rooms.Room;
+import com.eu.habbo.habbohotel.users.Habbo;
+import com.eu.habbo.habbohotel.users.HabboItem;
+import com.eu.habbo.messages.outgoing.handshake.ErrorReportComposer;
+
+/**
+ * Lets a rank 7 (Admin-only) user set a static picture on a Video TV's screen instead of
+ * a video -- either one of the built-in gallery presets or an image the admin uploaded
+ * themselves. The URL is restricted to one of the two configured base paths (gallery or
+ * upload) so this can't be used to point the screen at an arbitrary external URL. Setting
+ * a picture always clears any playing video, since the screen only has one slot to show.
+ */
+public class SetCustomPictureEvent extends YoutubeEvent {
+    private static final int REQUIRED_RANK = 7;
+
+    @Override
+    public void handle() {
+        int itemId = this.packet.readInt();
+        String url = this.packet.readString().trim();
+
+        Habbo habbo = this.client.getHabbo();
+
+        if (!validate(habbo)) return;
+
+        if (habbo.getHabboInfo().getPermissionGroup().getId() < REQUIRED_RANK) {
+            this.client.sendResponse(new ErrorReportComposer(1000));
+            return;
+        }
+
+        String galleryBase = Emulator.getConfig().getValue("custompicture.gallery.baseurl", "");
+        String uploadBase = Emulator.getConfig().getValue("custompicture.upload.baseurl", "");
+        boolean valid = (!galleryBase.isEmpty() && url.startsWith(galleryBase)) || (!uploadBase.isEmpty() && url.startsWith(uploadBase));
+
+        if (!valid) {
+            this.client.sendResponse(new ErrorReportComposer(1000));
+            return;
+        }
+
+        Room room = habbo.getHabboInfo().getCurrentRoom();
+        HabboItem item = room.getHabboItem(itemId);
+
+        if (!(item instanceof InteractionYoutubeTV tv)) return;
+
+        tv.cancelAdvancement();
+        tv.currentPlaylist = null;
+        tv.currentVideo = null;
+        tv.customVideoUrl = null;
+        tv.customPictureUrl = url;
+        tv.startedWatchingAt = 0;
+        tv.offset = 0;
+        tv.playing = false;
+
+        room.updateItem(tv);
+        item.needsUpdate(true);
+    }
+}
